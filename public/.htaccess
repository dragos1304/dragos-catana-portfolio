# Apache rules for the static site on Network Solutions (needs mod_rewrite / mod_headers; each block is guarded).
# Cloudflare note: set SSL/TLS mode to "Full (strict)" or the HTTPS redirect below can loop.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS (also honours Cloudflare's X-Forwarded-Proto)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://dragoscatana.com%{REQUEST_URI} [L,R=301]

  # www -> apex
  RewriteCond %{HTTP_HOST} ^www\.dragoscatana\.com$ [NC]
  RewriteRule ^ https://dragoscatana.com%{REQUEST_URI} [L,R=301]

  # /index.html and /folder/index.html -> the clean URL (one canonical address per page)
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
  RewriteRule ^ https://dragoscatana.com/%1 [L,R=301]

  # Trailing slash on folders, straight to HTTPS in one hop. Without this, Apache's mod_dir adds the
  # slash over plain HTTP behind Cloudflare (/servicii -> http://.../servicii/ -> https), a 2-hop chain.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://dragoscatana.com/$1/ [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Hashed build assets and fonts never change
  <FilesMatch "\.(js|css|woff2|webp|avif|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML and text files must stay fresh
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>
